.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*.log
*.pid

.venv*/
vendor/
node_modules/
remotion-app/node_modules/
remotion-app/dist/
remotion-app/out/
remotion-app/public/assets/

# Local databases and snapshots. Only the sanitized starter file is tracked.
data/*
!data/seed.example.json

# User media, generated outputs, research data and local backups.
assets/
voice/
voice_profiles/
subtitles/
renders/
previews/
agent/memory/
covers/
analytics/
reports/
narration/
content_cards/
caption-test-*/
webapp/tsconfig.tsbuildinfo

# Keep the compiled workspace so a source download can start without a local build.
!web/react-dist/assets/
!web/react-dist/assets/**

# Local-only migration preview build; production bundle remains untouched.
web/demo-dist/

# Local migration verification bundle
webapp/dist/

# Content-addressed render copies; original media remains in local task storage
remotion-app/public-static/yingxu-assets/

# Local license credentials and operator records must never be committed.
license/
*.encrypted.pem
customers.sqlite3*

# Local dependency environments may be symlinks on external disks.
/.venv-topics
/.venv-faster-whisper
